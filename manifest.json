{
  "manifest_version": 3,
  "name": "Dhruv Paleja - Coursera Assistant",
  "version": "3.0.1",
  "description": "Coursera Assistant by Dhruv Paleja. Repaired V3 with quiz, reading and video tools.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Dhruv Paleja - Coursera Assistant"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.coursera.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*.coursera.org/*",
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://quizsolver.infinityfreeapp.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pageBridge.js",
        "icons/logo.png"
      ],
      "matches": [
        "https://*.coursera.org/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "short_name": "Dhruv Paleja",
  "homepage_url": "https://github.com/dhruvpaleja/Dhruv-Paleja-Coursera"
}
